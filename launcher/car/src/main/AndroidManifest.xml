<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Close apps left running in the background (Clean button). Only background processes: never the
         app on screen, music that is playing or anything with a foreground service. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- See every installed app, for the grid and for closing background apps. Sideloaded, never on Play. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Android 11+: lets the Clean button show the system's own "clear all app caches?" dialog.
         Granted once at setup: appops set com.gathin.carhome MANAGE_EXTERNAL_STORAGE allow -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 9/10 cache clean: talks to the unit's own debugging service on 127.0.0.1:5555 only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dashboard speed from GPS when the CAN bus doesn't send it. Only while Home is on screen. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- The music widget's own player: reads music files, keeps playing behind other apps. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The car-data connection keeps running behind the reverse camera and other apps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The CAN finder reads the CAN app's CanBus folder in storage, only when asked. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Optional OBD-II Bluetooth adapter (Carista, ELM327). Talks only to the adapter the owner picks. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_car_home"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/CarHome">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:resumeWhilePausing="true"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CarDataService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <service
            android:name=".LocalPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Lets the music widget see what is playing. Reads no notifications. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="Glass Car music widget"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
